// =====================================================================
// KIXIMA Integration Service — Prisma schema
// Base de dados PRÓPRIA e SEPARADA do microserviço de integração.
// NÃO reutiliza nem referencia o banco do Kixima.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum ErpSystem {
  SAP_S4HANA
  PRIMAVERA
  ORACLE_ERP_CLOUD
  SAP_ARIBA
}

enum EventType {
  PURCHASE_ORDER_APPROVED // purchase_order.approved
  INVOICE_ISSUED          // invoice.issued
  GOODS_RECEIVED          // goods.received
  PAYMENT_COMPLETED       // payment.completed
}

enum EntityType {
  PURCHASE_ORDER
  INVOICE
  GOODS_RECEIPT
  PAYMENT
}

enum EventStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
  DUPLICATE
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  SKIPPED
}

enum AuditLevel {
  INFO
  WARN
  ERROR
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

// ---------------------------------------------------------------------
// Idempotência — garante que cada mensagem é processada uma única vez.
// A chave é o messageId/eventId do envelope publicado no kixima.events.
// ---------------------------------------------------------------------
model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique // eventId do envelope
  eventType EventType
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------
// Evento de integração — o envelope recebido do RabbitMQ.
// ---------------------------------------------------------------------
model IntegrationEvent {
  id          String      @id @default(uuid())
  eventId     String      @unique @map("event_id") // = messageId do broker
  eventType   EventType   @map("event_type")
  routingKey  String      @map("routing_key")
  source      String      @default("kixima")
  payload     Json
  headers     Json?
  status      EventStatus @default(RECEIVED)
  attempts    Int         @default(0)
  lastError   String?     @map("last_error")
  receivedAt  DateTime    @default(now()) @map("received_at")
  processedAt DateTime?   @map("processed_at")

  syncRecords ErpSyncRecord[]
  auditLogs   AuditLog[]
  webhooks    WebhookDelivery[]

  @@index([status])
  @@index([eventType])
  @@index([receivedAt])
  @@map("integration_events")
}

// ---------------------------------------------------------------------
// Registo de sincronização por ERP — resultado da chamada a cada adapter.
// request/response podem ser cifrados (AES-256-GCM) quando contêm dados
// sensíveis. Guardamos o externalId devolvido pelo ERP para reconciliação.
// ---------------------------------------------------------------------
model ErpSyncRecord {
  id                 String     @id @default(uuid())
  integrationEventId String     @map("integration_event_id")
  integrationEvent   IntegrationEvent @relation(fields: [integrationEventId], references: [id], onDelete: Cascade)

  erp          ErpSystem
  entityType   EntityType @map("entity_type")
  externalId   String?    @map("external_id") // id do documento no ERP
  status       SyncStatus @default(PENDING)
  attempts     Int        @default(0)
  requestEnc   String?    @map("request_enc")  // payload enviado (cifrado)
  responseEnc  String?    @map("response_enc") // resposta do ERP (cifrada)
  error        String?
  durationMs   Int?       @map("duration_ms")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([integrationEventId, erp, entityType])
  @@index([erp, status])
  @@index([externalId])
  @@map("erp_sync_records")
}

// ---------------------------------------------------------------------
// Auditoria — trilho completo de tudo o que acontece na integração.
// ---------------------------------------------------------------------
model AuditLog {
  id                 String     @id @default(uuid())
  integrationEventId String?    @map("integration_event_id")
  integrationEvent   IntegrationEvent? @relation(fields: [integrationEventId], references: [id], onDelete: SetNull)

  action    String
  erp       ErpSystem?
  level     AuditLevel @default(INFO)
  message   String
  actor     String     @default("system")
  metadata  Json?
  traceId   String?    @map("trace_id")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([action])
  @@index([level])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// Webhooks de retorno para o Kixima (callback do resultado).
// ---------------------------------------------------------------------
model WebhookDelivery {
  id                 String        @id @default(uuid())
  integrationEventId String?       @map("integration_event_id")
  integrationEvent   IntegrationEvent? @relation(fields: [integrationEventId], references: [id], onDelete: SetNull)

  url          String
  payload      Json
  status       WebhookStatus @default(PENDING)
  responseCode Int?          @map("response_code")
  attempts     Int           @default(0)
  lastError    String?       @map("last_error")
  deliveredAt  DateTime?     @map("delivered_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------
// Dead Letter — mensagens que esgotaram as tentativas.
// ---------------------------------------------------------------------
model DeadLetter {
  id         String    @id @default(uuid())
  eventId    String    @map("event_id")
  eventType  EventType @map("event_type")
  routingKey String    @map("routing_key")
  payload    Json
  attempts   Int       @default(0)
  lastError  String    @map("last_error")
  replayed   Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@index([replayed])
  @@map("dead_letters")
}

// ---------------------------------------------------------------------
// Credenciais de ERP guardadas cifradas (AES-256-GCM).
// ---------------------------------------------------------------------
model ErpCredential {
  id        String    @id @default(uuid())
  erp       ErpSystem @unique
  enabled   Boolean   @default(false)
  configEnc String    @map("config_enc") // JSON cifrado (baseUrl, user, secret…)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("erp_credentials")
}
