  {
    "nome": "criar PO",
    "como": "comprador",
    "metodo": "POST",
    "caminho": "/api/purchase-orders",
    "corpo": {
      "supplierCompanyId": "{{fornecedora}}",
      "items": [
        {
          "productId": "{{produto}}",
          "quantity": 2
        }
      ]
    },
    "guardar": {
      "po": "$.id"
    }
  },
  {
    "nome": "PO criada",
    "como": "comprador",
    "caminho": "/api/purchase-orders/{{po}}"
  },
  {
    "nome": "PO inexistente → 404",
    "como": "comprador",
    "caminho": "/api/purchase-orders/00000000-0000-0000-0000-000000000000"
  },
  {
    "nome": "PO inválida → 422",
    "como": "comprador",
    "metodo": "POST",
    "caminho": "/api/purchase-orders",
    "corpo": {
      "items": []
    }
  },
  {
    "nome": "aprovar PO",
    "como": "companyAdmin",
    "metodo": "PATCH",
    "caminho": "/api/purchase-orders/{{po}}/approve"
  },
  {
    "nome": "aceitar PO (gera fatura)",
    "como": "fornecedor",
    "metodo": "PATCH",
    "caminho": "/api/purchase-orders/{{po}}/accept"
  },
  {
    "nome": "PO com fatura",
    "como": "financeiro",
    "caminho": "/api/purchase-orders/{{po}}",
    "guardar": {
      "fatura": "$.invoice.id"
    }
  },
  {
    "nome": "faturas pendentes",
    "como": "financeiro",
    "caminho": "/api/payments/invoices/pending"
  },
  {
    "nome": "pagar fatura (comprovativo)",
    "como": "financeiro",
    "metodo": "POST",
    "caminho": "/api/payments/invoices/{{fatura}}/pay",
    "multipart": {
      "ficheiros": {
        "proof": {
          "nome": "comprovativo.pdf",
          "tipo": "application/pdf",
          "conteudo": "%PDF-1.4 comprovativo de teste"
        }
      }
    }
  },
  {
    "nome": "histórico de pagamentos",
    "como": "financeiro",
    "caminho": "/api/payments/history"
  },
  {
    "nome": "despachar",
    "como": "fornecedor",
    "metodo": "PATCH",
    "caminho": "/api/purchase-orders/{{po}}/dispatch"
  },
  {
    "nome": "entregue",
    "como": "fornecedor",
    "metodo": "PATCH",
    "caminho": "/api/purchase-orders/{{po}}/delivered"
  },
  {
    "nome": "receção conforme",
    "como": "comprador",
    "metodo": "PATCH",
    "caminho": "/api/purchase-orders/{{po}}/reception",
    "corpo": {
      "conforme": true
    }
  },
  {
    "nome": "PO concluída",
    "como": "comprador",
    "caminho": "/api/purchase-orders/{{po}}"
  },
  {
    "nome": "histórico da PO",
