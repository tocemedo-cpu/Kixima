{
  "name": "kixima-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-audit.mjs",
    "i18n:missing": "node scripts/i18n-audit.mjs --missing",
    "i18n:unused": "node scripts/i18n-audit.mjs --unused",
    "i18n:hardcoded": "node scripts/i18n-audit.mjs --hardcoded",
    "i18n:strict": "node scripts/i18n-audit.mjs --strict",
    "i18n:runtime": "node scripts/i18n-runtime-scan.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@sentry/react": "^10.69.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "prisma": "^5.22.0",
    "vite": "^5.4.6",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
