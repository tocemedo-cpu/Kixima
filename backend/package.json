{
  "name": "kixima-app",
  "version": "0.1.0",
  "private": true,
  "description": "KIXIMA — e-market com pagamento garantido para o setor Oil & Gas",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node -r dotenv/config src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "test": "cross-env NODE_ENV=test jest",
    "seed": "cross-env NODE_ENV=development node -r dotenv/config prisma/seed.js",
    "seed:demo": "cross-env NODE_ENV=development node -r dotenv/config prisma/seed.demo.js",
    "seed:catalog": "cross-env LOAD_DEMO_CATALOG=1 node -r dotenv/config prisma/seed.catalog.js",
    "seed:catalog-company": "node -r dotenv/config prisma/seed.catalog-company.js",
    "demo:remove": "node -r dotenv/config scripts/remove-demo-catalog.js",
    "storage:check": "node -r dotenv/config scripts/storage-check.js",
    "sentry:test": "node -r dotenv/config scripts/sentry-test.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:baseline": "prisma migrate resolve --applied 0_init",
    "migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^10.69.0",
    "adm-zip": "^0.6.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.4",
    "uuid": "^11.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
