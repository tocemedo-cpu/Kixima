# KIXIMA — Variáveis de Ambiente (exemplo)
# Copie este ficheiro para .env.development ou .env.production e preencha os valores reais.
# NUNCA faça commit de .env.development / .env.production / .env com valores reais.

# --- Ambiente ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# --- Base de dados ---
# Postgres local:
DATABASE_URL=postgresql://kixima:password@localhost:5432/kixima_dev
#
# --- Supabase (produção) ---
# A password é a "Database password" do dashboard (Project Settings -> Database).
#
# ⚠️ USE SEMPRE O POOLER (host `...pooler.supabase.com`). O host DIRETO
# `db.<ref>.supabase.co:5432` é SÓ IPv6 — em redes IPv4 (Render e a maioria) dá
# `P1001: Can't reach database server at db.<ref>.supabase.co:5432`. NÃO o uses.
#
# Copia as duas strings em Project Settings -> Database -> "Connect":
#   # App  → Transaction pooler, porta 6543 (com pgbouncer=true):
#   DATABASE_URL=postgresql://postgres.zbaybvxycwkyjkndjhly:SUA_DB_PASSWORD@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
#   # Migrações → Session pooler, porta 5432 (MESMO host do pooler, IPv4):
#   DIRECT_URL=postgresql://postgres.zbaybvxycwkyjkndjhly:SUA_DB_PASSWORD@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
#
# (Só usa o host direto db.<ref>.supabase.co se tiveres o add-on IPv4 do Supabase.)
#
# Em dev/teste local, DIRECT_URL = DATABASE_URL (Postgres local direto):
DIRECT_URL=postgresql://kixima:kixima@127.0.0.1:5432/kixima_dev
#
# Migrações: no arranque, o container corre `prisma migrate deploy`. 1ª vez numa
# base JÁ existente (criada por db push), fazer o baseline UMA vez (ver DEPLOY.md):
#   npm run migrate:baseline   # = prisma migrate resolve --applied 0_init

# --- Administrador do Sistema (seed de produção) ---
# `npm run seed` cria/atualiza APENAS esta conta (ADMIN_SISTEMA). Sem dados de demo.
# Para apagar dados de teste antigos e recriar do zero: `npm run db:reset` e depois `npm run seed`.
ADMIN_EMAIL=zelyvaldog@gmail.com
ADMIN_PASSWORD=defina-uma-senha-forte
ADMIN_NAME=Administrador KIXIMA

# --- Autenticação ---
# Segredo do JWT DA APLICAÇÃO (não é o JWT secret do Supabase). Gere um forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=7d

# --- Regras de negócio (configuráveis, não hardcoded) ---
PAYMENT_SLA_DAYS=7          # prazo de pagamento após aceitação da PO pelo fornecedor
POLICY_EXPIRY_ALERT_DAYS=30 # dias de antecedência para alerta de apólice a expirar

# --- Notificações ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notificacoes@kixima.co.ao

# --- Armazenamento de imagens de produtos ---
# 'local' = disco (dev; efémero em muitos hosts). 's3' = bucket persistente
# (AWS S3, Supabase Storage, Cloudflare R2, MinIO — qualquer S3-compatível).
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Só para S3-compatíveis (Supabase/R2/MinIO). Vazio = AWS S3.
STORAGE_ENDPOINT=
# URL público base para servir as imagens (bucket público / CDN).
STORAGE_PUBLIC_URL=
# path-style: true para Supabase/MinIO; deixa vazio para AWS.
STORAGE_FORCE_PATH_STYLE=
#
# --- Receita: Supabase Storage (recomendado, já usas Supabase) ---
#   1. Dashboard -> Storage -> cria um bucket PÚBLICO, ex.: "product-images".
#   2. Storage -> Settings -> S3 Connection: ativa e copia Access key/Secret.
#   3. Preenche:
#      STORAGE_PROVIDER=s3
#      STORAGE_BUCKET=product-images
#      STORAGE_REGION=eu-central-1          # a região do teu projeto
#      STORAGE_ENDPOINT=https://zbaybvxycwkyjkndjhly.supabase.co/storage/v1/s3
#      STORAGE_PUBLIC_URL=https://zbaybvxycwkyjkndjhly.supabase.co/storage/v1/object/public/product-images
#      STORAGE_ACCESS_KEY=...  STORAGE_SECRET_KEY=...
#      STORAGE_FORCE_PATH_STYLE=true

# --- Conta bancária das subscrições ---
# Para onde as empresas transferem quando pedem ou renovam um plano. Só o IBAN
# é obrigatório. NÃO é um segredo: existe para ser dado a quem paga, e a página
# de Prontidão mostra-o por inteiro para se poder conferir a conta.
# Sem o IBAN não há erro nenhum — a plataforma emite a cobrança na mesma e a
# empresa fica sem saber para onde transferir.
KIXIMA_BANCO_IBAN=
KIXIMA_BANCO_TITULAR=
KIXIMA_BANCO_NOME=
KIXIMA_BANCO_SWIFT=
KIXIMA_BANCO_MOEDA=USD

# --- Terceiros ---
# Rastreio de erros (Sentry). Vazio = desligado. Preenche o DSN do teu projeto
# Sentry (backend). Para o frontend, define VITE_SENTRY_DSN no build do frontend.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info

# --- Limites de pedidos ---
# O limite geral conta por PESSOA quando há sessão e por endereço quando não há.
# Contar sempre por endereço castigava escritórios inteiros atrás de um NAT.
# Só se mexe nestes valores com um motivo medido.
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=60

# --- Retenção de dados (dias) ---
# Publicados em /api/retencao e aplicados pela limpeza automática diária.
# Mudar aqui muda o que a política de privacidade mostra.
RETENCAO_NOTIFICACOES_DIAS=180
RETENCAO_CONVITES_DIAS=90
RETENCAO_CODIGOS_DIAS=1

# --- Tecto das leituras em lista ---
# Rede de segurança, não paginação. Quando é atingido, fica registado um erro
# com o modelo e a linha da consulta — uma leitura truncada em silêncio daria
# totais errados com ar de certos.
DB_MAX_ROWS=1000
