# KIXIMA — Variáveis de Ambiente (exemplo)
# Copie este ficheiro para .env.development ou .env.production e preencha os valores reais.
# NUNCA faça commit de .env.development / .env.production / .env com valores reais.

# --- Ambiente ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# --- Base de dados ---
# Postgres local:
DATABASE_URL=postgresql://kixima:password@localhost:5432/kixima_dev
#
# --- Supabase (produção) ---
# O Prisma liga-se por ligação Postgres DIRETA (não usa as chaves anon/service_role
# nem a REST API). A password é a "Database password" do dashboard:
#   Project Settings -> Database -> Database password
#
# Ligação DIRETA (é IPv6). Bom para migrações/seed:
#   DATABASE_URL=postgresql://postgres:SUA_DB_PASSWORD@db.SEU_REF.supabase.co:5432/postgres?sslmode=require
#
# Se a sua rede for só IPv4 (comum), use o CONNECTION POOLER (IPv4) — copie a string
# exata em: Project Settings -> Database -> Connection string -> "Connection pooling"
# (Session mode / porta 5432 para o Prisma):
#   DATABASE_URL=postgresql://postgres.SEU_REF:SUA_DB_PASSWORD@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
#
# Depois de definir: `npx prisma db push` cria as tabelas, `npm run seed` popula os dados.

# --- Autenticação ---
# Segredo do JWT DA APLICAÇÃO (não é o JWT secret do Supabase). Gere um forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=7d

# --- Regras de negócio (configuráveis, não hardcoded) ---
PAYMENT_SLA_DAYS=7          # prazo de pagamento após aceitação da PO pelo fornecedor
POLICY_EXPIRY_ALERT_DAYS=30 # dias de antecedência para alerta de apólice a expirar

# --- Notificações ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notificacoes@kixima.co.ao

# --- Armazenamento de documentos (apólices, certificados) ---
STORAGE_PROVIDER=s3
STORAGE_BUCKET=kixima-documentos
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Terceiros ---
SENTRY_DSN=
LOG_LEVEL=info
