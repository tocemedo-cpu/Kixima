// KIXIMA — Schema de base de dados (Prisma / PostgreSQL)
// Reflete a especificação funcional: due diligence, PO, pagamento garantido em 7 dias,
// apólices (Fornecedor→KIXIMA e KIXIMA→Cliente), contratos/call-offs, notificações.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App: pooler de TRANSAÇÃO do Supabase (porta 6543, pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrações/DDL: pooler de SESSÃO (porta 5432, mesmo host `...pooler.supabase.com`,
  // IPv4). NÃO usar o host direto `db.<ref>.supabase.co` (só IPv6 → P1001). Em
  // dev/teste local pode ser igual ao DATABASE_URL (Postgres local direto).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Empresas e utilizadores
// ---------------------------------------------------------------------------

enum CompanyType {
  CLIENTE
  FORNECEDOR
}

// Dimensão da empresa (critério MPME angolano, Lei n.º 30/11): decide o plano
// elegível. GRANDE exige o plano PRO.
enum CompanySize {
  MICRO
  PEQUENA
  MEDIA
  GRANDE
}

// Plano de subscrição. BASICO: versão essencial, taxa de acesso por utilizador.
// PRO: obrigatório para grandes empresas — inclui integração com ERPs externos
// (SAP, AS400, Ariba, Maximo, Oracle e outros).
enum CompanyPlan {
  ENTRADA
  CORE
  PRO
  // Plano do modelo de dois degraus. As empresas foram migradas para CORE; o
  // valor fica no enum porque removê-lo obrigaria a recriar o tipo, e o código
  // trata-o como sinónimo de CORE.
  BASICO
}

enum CompanyStatus {
  PENDENTE // aguarda due diligence
  APROVADA
  REJEITADA
  SUSPENSA
}

// Documentos exigidos no cadastro (secção 4.1). Operadora/cliente: certidão
// comercial + alvará comercial. Fornecedora: alvará comercial + licença ANPG +
// certidão comercial.
enum DocumentType {
  CERTIDAO_COMERCIAL
  ALVARA_COMERCIAL
  LICENCA_ANPG
}

enum PersonaRole {
  COMPRADOR
  COMPANY_ADMIN
  FORNECEDOR
  FINANCEIRO
  ADMIN_SISTEMA // interno KIXIMA, não pertence a nenhuma empresa transacionadora
}

model Company {
  id           String        @id @default(uuid())
  name         String
  taxId        String        @unique @map("tax_id")
  type         CompanyType
  status       CompanyStatus @default(PENDENTE)
  contactEmail String        @map("contact_email")
  contactPhone String?       @map("contact_phone")
  address      String?
  verified     Boolean       @default(false) // selo "Fornecedor Verificado"
  logoUrl      String?       @map("logo_url")
  city         String?
  province     String?
  country      String?       @default("Angola")
  settings     Json? // preferências da empresa (tela Configurações do Company Admin)

  // Dados bancários do fornecedor (para pagamento; aparecem na fatura/PDF).
  bankName String? @map("bank_name")
  iban     String?
  swift    String?

  // Aceite dos Termos de Uso e Política de Privacidade no cadastro (quem
  // regista aceita em nome da empresa; obrigatório no formulário).
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  // --- Dimensão e plano (modelo comercial) ---------------------------------
  // Declarados no cadastro e confirmáveis pelo Admin do Sistema na due diligence.
  employees        Int?        @map("employees") // nº de trabalhadores
  annualRevenueUsd Decimal?    @map("annual_revenue_usd") @db.Decimal(16, 2)
  size             CompanySize @default(PEQUENA)
  plan             CompanyPlan @default(ENTRADA)
  // Posição na ordenação por relevância do marketplace, derivada do plano.
  // Denormalizada de propósito: ordenar pelo enum daria a ordem de DECLARAÇÃO
  // do tipo no Postgres, que não é a ordem comercial e mudaria sozinha se
  // alguém acrescentasse um valor ao enum.
  searchRank       Int         @default(0) @map("search_rank")
  // Preço por utilizador/mês (USD). Teto do plano BASICO: 100 USD.
  seatPriceUsd     Decimal     @default(100) @map("seat_price_usd") @db.Decimal(10, 2)
  planNotes        String?     @map("plan_notes")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  approvedAt DateTime? @map("approved_at")
  rejectedAt DateTime? @map("rejected_at")

  users               User[]
  productsOffered     Product[]                @relation("SupplierProducts")
  purchaseOrdersMade  PurchaseOrder[]          @relation("BuyerCompanyOrders")
  purchaseOrdersRecv  PurchaseOrder[]          @relation("SupplierCompanyOrders")
  contractsAsClient   Contract[]               @relation("ClientContracts")
  contractsAsSupplier Contract[]               @relation("SupplierContracts")
  supplierPolicies    SupplierToKiximaPolicy[]
  clientPolicies      KiximaToClientPolicy[]
  notifications       Notification[]
  budgetLimit         BudgetLimit?
  documents           CompanyDocument[]
  kits                Kit[]                    @relation("SupplierKits")
  quotesAsBuyer       QuoteRequest[]           @relation("BuyerQuotes")
  quotesAsSupplier    QuoteRequest[]           @relation("SupplierQuotes")
  erpConfig           CompanyErpConfig?
  erpConfigAudits     CompanyErpConfigAudit[]
  employeeInvites     EmployeeInvite[]
  platformFees        PlatformFee[]
  supplierDevRequests SupplierDevRequest[]

  @@map("companies")
}

// ---------------------------------------------------------------------------
// Contador de referências (PO-2026-000123, FAT-…, SD-…).
//
// Antes o número saía de um COUNT das linhas existentes. Não é atómico — dois
// pedidos simultâneos contam o mesmo valor e geram a MESMA referência, e o
// segundo rebenta com conflito — e desfaz-se com qualquer eliminação, porque o
// número libertado volta a ser atribuído a uma referência que já existe.
// Aqui o valor é incrementado atomicamente pela base de dados e nunca recua.
// ---------------------------------------------------------------------------
model ReferenceCounter {
  key   String @id // ex: "PO-2026"
  value Int    @default(0)

  @@map("reference_counters")
}

// ---------------------------------------------------------------------------
// Taxa da plataforma (comissão KIXIMA). Fica À PARTE da PO/Fatura (nenhum dos
// documentos a mostra) — é gerada na transação do pagamento e cobrada à
// empresa. Composição: (nº de POs × valor por PO) + valor fixo por fatura.
// ---------------------------------------------------------------------------
enum PlatformFeeStatus {
  PENDENTE
  COBRADO
}

model PlatformFee {
  id         String            @id @default(uuid())
  companyId  String            @map("company_id")
  company    Company           @relation(fields: [companyId], references: [id])
  invoiceId  String            @unique @map("invoice_id")
  invoice    Invoice           @relation(fields: [invoiceId], references: [id])
  poCount    Int               @map("po_count")
  perPo      Decimal           @map("per_po") @db.Decimal(14, 2)
  perInvoice Decimal           @map("per_invoice") @db.Decimal(14, 2)
  amount     Decimal           @db.Decimal(14, 2)
  currency   String            @default("USD")
  // Base de cálculo da parcela por PO: FIXO (≤ limiar) ou PERCENTUAL (> limiar).
  basis      String?           @map("basis")
  // Valor da transação em USD e câmbio usado — guardados para auditoria, já que
  // as POs são em Kwanzas e o limiar dos 0,20% está em dólares.
  poValueUsd Decimal?          @map("po_value_usd") @db.Decimal(16, 2)
  fxRate     Decimal?          @map("fx_rate") @db.Decimal(14, 4)
  status     PlatformFeeStatus @default(PENDENTE)
  chargedAt  DateTime?         @map("charged_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([companyId])
  @@map("platform_fees")
}

// ---------------------------------------------------------------------------
// Convite de funcionário emitido pelo Company Admin. Persiste o convite para
// permitir estado (Pendente/Aceito/Expirado/Cancelado), reenvio e cancelamento.
// O envio do link é automático (email); reutiliza o token assinado existente.
// ---------------------------------------------------------------------------
enum InviteStatus {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
}

model EmployeeInvite {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String
  role        PersonaRole
  token       String       @unique
  status      InviteStatus @default(PENDENTE)
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([email])
  @@map("employee_invites")
}

// ---------------------------------------------------------------------------
// Configuração ERP por empresa (pós-aprovação). Liga-se à empresa existente,
// não a recria. As credenciais ficam cifradas (AES-256-GCM) em configEnc.
// A execução real da integração é feita pelo kixima-integration-service.
// ---------------------------------------------------------------------------
enum CompanyErpSystem {
  MANUAL // "Sem ERP" — comportamento normal do Kixima
  PRIMAVERA
  SAP_S4HANA
  ORACLE_ERP_CLOUD
  SAP_ARIBA
}

model CompanyErpConfig {
  id              String           @id @default(uuid())
  companyId       String           @unique @map("company_id")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  erp             CompanyErpSystem @default(MANUAL)
  configEnc       String?          @map("config_enc") // credenciais cifradas (null quando MANUAL)
  lastTestAt      DateTime?        @map("last_test_at")
  lastTestOk      Boolean?         @map("last_test_ok")
  lastTestMessage String?          @map("last_test_message")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("company_erp_configs")
}

model CompanyErpConfigAudit {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action      String // SET | TEST | REMOVE
  fromErp     CompanyErpSystem? @map("from_erp")
  toErp       CompanyErpSystem? @map("to_erp")
  actorUserId String?           @map("actor_user_id")
  actorName   String?           @map("actor_name")
  result      String?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([companyId])
  @@map("company_erp_config_audits")
}

// Documento de credenciamento submetido no cadastro de uma empresa.
model CompanyDocument {
  id           String       @id @default(uuid())
  companyId    String       @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileUrl      String       @map("file_url")
  originalName String       @map("original_name")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([companyId])
  @@map("company_documents")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         PersonaRole
  approvalCap  Decimal?    @map("approval_cap") @db.Decimal(14, 2) // teto para aprovações delegadas (Comprador)

  companyId String?  @map("company_id") // null para ADMIN_SISTEMA
  company   Company? @relation(fields: [companyId], references: [id])

  avatarUrl       String?   @map("avatar_url") // foto de perfil (upload ou câmera)
  // Idioma escolhido na plataforma (pt/en/fr). Guardado no servidor para os
  // EMAILS saírem na língua do destinatário — o localStorage do browser não
  // serve para nada quando é o servidor a escrever a mensagem.
  locale          String?   @map("locale")
  active          Boolean   @default(true)
  // Versão de sessão: incrementar invalida imediatamente todos os tokens JWT
  // já emitidos para este utilizador (logout global, troca de senha, etc.).
  tokenVersion    Int       @default(0) @map("token_version")
  // Aceite individual dos Termos/Privacidade (registo por convite).
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  // --- Verificação em dois passos -------------------------------------------
  // NOTA SOBRE O NOME: `totpEnabledAt` é histórico — hoje significa "2FA ativa
  // desde", seja qual for o método. Mantém-se assim de propósito: renomear a
  // coluna obrigaria a uma migração numa base em produção sem nada ganhar para
  // quem usa a plataforma. É `mfaMethod` que diz de que método se trata.
  //
  //   EMAIL → o código de 6 dígitos é enviado para o email da pessoa (omissão)
  //   TOTP  → app de autenticação; mantido para quem já a tinha configurada
  mfaMethod       String?   @map("mfa_method")
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  // Código enviado por email, à espera de confirmação. Guarda-se o HASH: é uma
  // credencial, e quem lê a base não pode entrar na conta de ninguém.
  mfaCodeHash     String?   @map("mfa_code_hash")
  mfaCodeExpiraEm DateTime? @map("mfa_code_expira_em")
  // Tentativas falhadas neste código. Ao fim de poucas, o código morre — sem
  // isto, dez minutos de validade dariam para tentar muitos dos 10^6 valores.
  mfaCodeTentativas Int     @default(0) @map("mfa_code_tentativas")
  // Trava reenvios seguidos (e impede usar a plataforma para enviar email a
  // outra pessoa em catadupa).
  mfaCodeEnviadoEm DateTime? @map("mfa_code_enviado_em")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  purchaseOrdersCreated  PurchaseOrder[] @relation("PoCreatedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("PoApprovedBy")
  notifications          Notification[]
  favorites              Favorite[]
  reviews                Review[]
  savedSearches          SavedSearch[]

  @@index([companyId])
  @@map("users")
}

// Pesquisa guardada pelo comprador ("Guardar Pesquisa").
model SavedSearch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  query     String // querystring (ex.: q=UT&kind=SERVICO&country=Angola)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_searches")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Product {
  id         String  @id @default(uuid())
  supplierId String  @map("supplier_id")
  supplier   Company @relation("SupplierProducts", fields: [supplierId], references: [id])

  // --- Identificação ---
  name             String
  sku              String? // referência interna do fornecedor
  manufacturerCode String? @map("manufacturer_code") // código do fabricante
  category         String
  subcategory      String?
  brand            String?
  manufacturer     String?
  model            String?
  countryOfOrigin  String? @map("country_of_origin")

  // --- Descrição ---
  description     String? // descrição curta (usada nos cartões do marketplace)
  fullDescription String? @map("full_description")
  applications    String?
  benefits        String?
  keywords        String?

  // --- Classificação (UNSPSC, preenchida via dropdown em cascata) ---
  unspscCode    String? @map("unspsc_code") // ex.: 40141607
  unspscTitle   String? @map("unspsc_title") // título oficial (EN)
  unspscSegment String? @map("unspsc_segment") // 2 dígitos
  unspscFamily  String? @map("unspsc_family") // 4 dígitos
  unspscClass   String? @map("unspsc_class") // 6 dígitos

  // --- Atributos universais (livres, comuns a qualquer produto/serviço) ---
  keySpec       String? @map("key_spec") // Especificação principal
  standard      String? // Norma / Certificação
  warranty      String? // Garantia / Validade
  incoterm      String? // Incoterm (ex.: DAP, EXW, CIF) — comparação de fornecedores
  supplierNotes String? @map("supplier_notes") // Comentários do fornecedor

  // --- Especificações técnicas (texto livre — os valores variam muito) ---
  material        String?
  weight          String?
  height          String?
  width           String?
  length          String?
  pressure        String?
  temperature     String?
  power           String?
  voltage         String?
  measurementUnit String? @map("measurement_unit")

  // --- Preço ---
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  promoPrice  Decimal? @map("promo_price") @db.Decimal(14, 2)
  currency    String   @default("AOA")
  minQuantity Int?     @map("min_quantity")
  maxQuantity Int?     @map("max_quantity")

  // --- Estoque ---
  stockQuantity Int?    @map("stock_quantity")
  warehouse     String?
  leadTimeDays  Int?    @map("lead_time_days") // tempo de entrega (dias)
  availability  String? // "Em stock" | "Sob encomenda" | "Esgotado"
  minStock      Int?    @map("min_stock")

  // --- Marketplace (Serviços/Produtos) ---
  slug           String?     @unique // URL amigável (ex.: inspecao-por-ultrassom-ut)
  kind           ProductKind @default(PRODUTO) // PRODUTO | SERVICO
  specialty      String? // especialidade (serviços)
  city           String?
  province       String?
  country        String?     @default("Angola")
  certifications String[]    @default([]) // ex.: ISO 9001, API Q1
  tags           String[]    @default([])

  active Boolean @default(true)

  // Reputação (marketplace) — média de avaliações e nº de avaliações.
  rating      Float?
  reviewCount Int     @default(0) @map("review_count")
  viewCount   Int     @default(0) @map("view_count") // nº de visualizações por compradores
  imageUrl    String? @map("image_url") // imagem principal (destaque no marketplace)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poItems    PurchaseOrderItem[]
  images     ProductImage[]
  documents  ProductDocument[]
  movements  StockMovement[]
  kitItems   KitItem[]
  quoteItems QuoteItem[]
  favorites  Favorite[]
  reviews    Review[]

  @@index([category])
  @@index([kind])
  @@index([supplierId])
  @@map("products")
}

enum ProductKind {
  PRODUTO
  SERVICO
}

// Favorito (coração) — persistido por utilizador.
model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// Avaliação de um produto/serviço por um comprador.
model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

enum QuoteStatus {
  ABERTA // pedido enviado, a aguardar resposta do fornecedor
  RESPONDIDA // fornecedor respondeu com preço/prazo
  FECHADA // comprador encerrou o pedido
}

// Pedido de cotação (RFQ): comprador pede preço a um fornecedor por itens.
model QuoteRequest {
  id                String  @id @default(uuid())
  buyerCompanyId    String  @map("buyer_company_id")
  buyerCompany      Company @relation("BuyerQuotes", fields: [buyerCompanyId], references: [id])
  supplierCompanyId String  @map("supplier_company_id")
  supplierCompany   Company @relation("SupplierQuotes", fields: [supplierCompanyId], references: [id])
  createdById       String  @map("created_by_id")

  status QuoteStatus @default(ABERTA)
  note   String?

  responsePrice    Decimal?  @map("response_price") @db.Decimal(14, 2)
  responseLeadDays Int?      @map("response_lead_days")
  responseNote     String?   @map("response_note")
  respondedAt      DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items QuoteItem[]

  @@index([buyerCompanyId])
  @@index([supplierCompanyId])
  @@map("quote_requests")
}

model QuoteItem {
  id             String       @id @default(uuid())
  quoteRequestId String       @map("quote_request_id")
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id")
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int          @default(1)

  @@index([productId])
  @@index([quoteRequestId])
  @@map("quote_items")
}

// Kit: conjunto de produtos vendidos como pacote (organização do catálogo).
model Kit {
  id          String    @id @default(uuid())
  supplierId  String    @map("supplier_id")
  supplier    Company   @relation("SupplierKits", fields: [supplierId], references: [id])
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  items       KitItem[]

  @@index([supplierId])
  @@map("kits")
}

model KitItem {
  id        String  @id @default(uuid())
  kitId     String  @map("kit_id")
  kit       Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@index([kitId])
  @@index([productId])
  @@map("kit_items")
}

enum StockMovementType {
  ENTRADA
  SAIDA
}

// Movimento de inventário (entrada/saída) que ajusta o stock do produto.
model StockMovement {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  note        String?
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([productId])
  @@map("stock_movements")
}

// Galeria de imagens do produto (a principal também fica em Product.imageUrl).
model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

enum ProductDocType {
  FICHA_TECNICA
  DATASHEET
  MANUAL
  CATALOGO
  CERTIFICADO
  DESENHO_TECNICO
}

// Documentos técnicos anexados ao produto (ficha técnica, datasheet, etc.).
model ProductDocument {
  id           String         @id @default(uuid())
  productId    String         @map("product_id")
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         ProductDocType
  fileUrl      String         @map("file_url")
  originalName String         @map("original_name")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_documents")
}

// ---------------------------------------------------------------------------
// Ordens de Compra (PO) — fluxo central
// ---------------------------------------------------------------------------

enum PoStatus {
  AGUARDANDO_APROVACAO
  APROVADA
  REJEITADA
  ACEITE_FORNECEDOR // fornecedor aceitou -> relógio dos 7 dias começa
  RECUSADA_FORNECEDOR
  AGUARDANDO_PAGAMENTO
  PAGA
  EM_EXECUCAO
  ENTREGUE
  RECEBIDA_CONFORME
  RECEBIDA_COM_DIVERGENCIA
  CONCLUIDA
}

model PurchaseOrder {
  id        String @id @default(uuid())
  reference String @unique // ex: PO-2026-00001

  buyerCompanyId String  @map("buyer_company_id")
  buyerCompany   Company @relation("BuyerCompanyOrders", fields: [buyerCompanyId], references: [id])

  supplierCompanyId String  @map("supplier_company_id")
  supplierCompany   Company @relation("SupplierCompanyOrders", fields: [supplierCompanyId], references: [id])

  createdById String @map("created_by_id")
  createdBy   User   @relation("PoCreatedBy", fields: [createdById], references: [id])

  approvedById String? @map("approved_by_id")
  approvedBy   User?   @relation("PoApprovedBy", fields: [approvedById], references: [id])

  status            PoStatus @default(AGUARDANDO_APROVACAO)
  // totalAmount é o que o comprador se compromete a pagar: JÁ COM IVA, igual ao
  // total da fatura que a PO vai gerar. O líquido e o imposto ficam guardados à
  // parte para o documento os poder discriminar e para a contabilidade.
  totalAmount       Decimal  @map("total_amount") @db.Decimal(14, 2)
  netAmount         Decimal? @map("net_amount") @db.Decimal(14, 2) // subtotal sem IVA
  taxAmount         Decimal? @map("tax_amount") @db.Decimal(14, 2) // IVA
  withholdingAmount Decimal? @map("withholding_amount") @db.Decimal(14, 2) // retenção na fonte II (serviços)
  currency          String   @default("AOA")

  // Call-off: PO emitida ao abrigo de contrato-quadro ativo -> dispensa aprovação e pagamento antecipado por PO
  isCallOff  Boolean   @default(false) @map("is_call_off")
  contractId String?   @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id])

  // Relógio dos 7 dias (ou prazo do contrato, se call-off)
  acceptedAt   DateTime? @map("accepted_at") // gatilho do prazo de pagamento
  paymentDueAt DateTime? @map("payment_due_at") // acceptedAt + PAYMENT_SLA_DAYS (ou prazo do contrato)
  paidAt       DateTime? @map("paid_at")

  dispatchedAt    DateTime? @map("dispatched_at")
  deliveredAt     DateTime? @map("delivered_at")
  receivedAt      DateTime? @map("received_at")
  receptionStatus String?   @map("reception_status") // "Conforme" | "Não Entregue" | "Com Divergência"

  // Resolução de divergências: o comprador fecha a divergência aceitando a
  // entrega (→ CONCLUIDA) ou pedindo reposição ao fornecedor (→ EM_EXECUCAO,
  // que reabre o ciclo entrega→receção). Fica o registo de quem/quando/como.
  divergenceResolution      String?   @map("divergence_resolution") // ACEITE | REPOSICAO
  divergenceResolutionNotes String?   @map("divergence_resolution_notes")
  divergenceResolvedAt      DateTime? @map("divergence_resolved_at")

  approvedAt      DateTime? @map("approved_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   PurchaseOrderItem[]
  invoice Invoice?

  @@index([status])
  @@index([buyerCompanyId])
  @@index([supplierCompanyId])
  @@index([approvedById])
  @@index([contractId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  @@index([productId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Faturas e Pagamentos (geradas automaticamente na aceitação da PO)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

model Invoice {
  id        String @id @default(uuid())
  reference String @unique // ex: FAT-2026-00001

  purchaseOrderId String?        @unique @map("purchase_order_id") // null se fatura consolidada de call-offs
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  // Faturamento consolidado de call-offs de um contrato (periódico)
  contractId        String?   @map("contract_id")
  contract          Contract? @relation(fields: [contractId], references: [id])
  consolidatedPoIds String[]  @default([]) @map("consolidated_po_ids")

  amount            Decimal       @db.Decimal(14, 2) // total a pagar pelo comprador (com IVA)
  netAmount         Decimal?      @map("net_amount") @db.Decimal(14, 2) // subtotal sem IVA
  taxAmount         Decimal?      @map("tax_amount") @db.Decimal(14, 2) // IVA (14%)
  withholdingAmount Decimal?      @map("withholding_amount") @db.Decimal(14, 2) // retenção na fonte II (6,5% serviços)
  currency          String        @default("AOA")
  status            InvoiceStatus @default(PENDENTE)

  issuedAt DateTime @default(now()) @map("issued_at")
  dueAt    DateTime @map("due_at")

  payment     Payment?
  platformFee PlatformFee?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@map("invoices")
}

enum PaymentStatus {
  PROCESSADO
  FALHOU
}

model Payment {
  id        String  @id @default(uuid())
  invoiceId String  @unique @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("AOA")
  status        PaymentStatus @default(PROCESSADO)
  processedById String        @map("processed_by_id") // utilizador Financeiro que executou
  reference     String        @unique // referência da transação

  // Comprovativo da transferência (obrigatório ao pagar) — prova de que o
  // dinheiro saiu, visível ao fornecedor.
  proofUrl  String? @map("proof_url")
  proofName String? @map("proof_name")

  // Confirmação de receção do valor pelo fornecedor (fecha o ciclo de confiança).
  receivedAt   DateTime? @map("received_at")
  receivedById String?   @map("received_by_id")

  processedAt DateTime @default(now()) @map("processed_at")

  @@map("payments")
}

// Limite de orçamento simples por empresa/centro de custo (opcional, MVP)
model BudgetLimit {
  id        String  @id @default(uuid())
  companyId String  @unique @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  periodMonthly Decimal @map("period_monthly") @db.Decimal(14, 2)
  currency      String  @default("AOA")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("budget_limits")
}

// ---------------------------------------------------------------------------
// Apólices de seguro
// ---------------------------------------------------------------------------

enum PolicyStatus {
  SUBMETIDA
  APROVADA
  REJEITADA
  EXPIRADA
}

// Fornecedor → KIXIMA: submetida no onboarding, condição para credenciamento
model SupplierToKiximaPolicy {
  id        String  @id @default(uuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  policyNumber   String       @map("policy_number")
  insurer        String
  coverageAmount Decimal      @map("coverage_amount") @db.Decimal(14, 2)
  currency       String       @default("AOA")
  status         PolicyStatus @default(SUBMETIDA)

  validFrom   DateTime @map("valid_from")
  validUntil  DateTime @map("valid_until")
  documentUrl String?  @map("document_url") // PDF/imagem da apólice submetida no cadastro

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("supplier_to_kixima_policies")
}

// KIXIMA → Cliente: emitida pelo Admin do Sistema após due diligence, escopo por empresa
model KiximaToClientPolicy {
  id        String  @id @default(uuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  policyNumber   String       @map("policy_number")
  insurer        String
  coverageAmount Decimal      @map("coverage_amount") @db.Decimal(14, 2)
  currency       String       @default("AOA")
  status         PolicyStatus @default(APROVADA)

  issuedById String @map("issued_by_id") // Admin do Sistema KIXIMA

  validFrom  DateTime @map("valid_from")
  validUntil DateTime @map("valid_until")

  expiryAlertSentAt DateTime? @map("expiry_alert_sent_at") // evita reenviar alerta dos 30 dias

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("kixima_to_client_policies")
}

// ---------------------------------------------------------------------------
// Contratos-quadro e Call-offs
// ---------------------------------------------------------------------------

enum ContractStatus {
  ATIVO
  EXPIRADO
  ENCERRADO
}

enum BillingPeriodicity {
  TRIMESTRAL
  SEMESTRAL
}

model Contract {
  id        String @id @default(uuid())
  reference String @unique // ex: CTR-2026-0001

  clientCompanyId String  @map("client_company_id")
  clientCompany   Company @relation("ClientContracts", fields: [clientCompanyId], references: [id])

  supplierCompanyId String  @map("supplier_company_id")
  supplierCompany   Company @relation("SupplierContracts", fields: [supplierCompanyId], references: [id])

  categoriesCovered String[] @map("categories_covered") // categorias/itens cobertos pelo contrato

  totalValue Decimal @map("total_value") @db.Decimal(14, 2)
  currency   String  @default("AOA")
  usedValue  Decimal @default(0) @map("used_value") @db.Decimal(14, 2)

  billingPeriodicity BillingPeriodicity @map("billing_periodicity")
  paymentTermDays    Int                @map("payment_term_days") // prazo próprio do contrato (substitui os 7 dias padrão)

  status     ContractStatus @default(ATIVO)
  validFrom  DateTime       @map("valid_from")
  validUntil DateTime       @map("valid_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  callOffs             PurchaseOrder[]
  consolidatedInvoices Invoice[]

  @@index([clientCompanyId])
  @@index([supplierCompanyId])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// Notificações
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  IN_APP_EMAIL
}

enum NotificationType {
  PO_AGUARDA_APROVACAO
  PO_APROVADA
  PO_REJEITADA
  PO_RECEBIDA_FORNECEDOR
  FATURA_GERADA
  PAGAMENTO_PROCESSADO
  ENTREGA_DESPACHADA
  RECECAO_COM_DIVERGENCIA
  DIVERGENCIA_RESOLVIDA
  SUPPLIER_DEV_RECEBIDA
  APOLICE_SUBMETIDA_APROVADA
  APOLICE_A_EXPIRAR
  CADASTRO_EMPRESA_APROVADO
  CADASTRO_EMPRESA_REJEITADO
}

model Notification {
  id String @id @default(uuid())

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  type    NotificationType
  channel NotificationChannel @default(IN_APP)
  title   String
  message String
  readAt  DateTime?           @map("read_at")

  relatedEntityType String? @map("related_entity_type") // "PurchaseOrder" | "Invoice" | "Policy" | "Company" ...
  relatedEntityId   String? @map("related_entity_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([companyId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Ajuda & Suporte — pedidos de suporte (tickets) do utilizador
// ---------------------------------------------------------------------------
enum SupportStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_RESPOSTA
  RESOLVIDO
  FECHADO
}

// Imagem de uma categoria de ajuda. Só o Administrador do Sistema faz upload
// e pode trocar estas fotos (tela Ajuda & Suporte).
model SupportCategoryImage {
  key       String   @id
  imageUrl  String   @map("image_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_category_images")
}

model SupportTicket {
  id        String        @id @default(uuid())
  reference String        @unique // ex: SUP-2026-00001
  userId    String        @map("user_id")
  companyId String?       @map("company_id")
  subject   String
  category  String
  message   String
  status    SupportStatus @default(ABERTO)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("support_tickets")
}

// ---------------------------------------------------------------------------
// Trilho de auditoria financeira — APPEND-ONLY. Regista quem fez o quê, quando
// e de que IP, nas ações com peso financeiro/legal (aprovações, pagamentos,
// due diligence, dados bancários…). Sem relações e com o ator DESNORMALIZADO
// (nome/perfil copiados no momento): o registo fica imutável mesmo que o
// utilizador mude de nome ou seja removido. O código nunca faz UPDATE/DELETE.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  action     String // ex.: PO_APROVADA, PAGAMENTO_EXECUTADO, TAXA_COBRADA
  entityType String   @map("entity_type") // PurchaseOrder | Invoice | Payment | Company | PlatformFee | User
  entityId   String?  @map("entity_id")
  entityRef  String?  @map("entity_ref") // referência legível (PO-2026-00001, FAT-…)
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  actorRole  String?  @map("actor_role")
  companyId  String?  @map("company_id") // empresa do ator
  ip         String?
  detail     Json? // montantes, estado anterior→novo, etc.
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Supplier Development — programa de apoio ao fornecedor nacional: acompanha a
// emancipação burocrática (registos, licenças, certificações) e procura
// PARCEIROS INTERNACIONAIS para empresas locais, trazendo mais tecnologia e
// mais participação angolana ao setor. As candidaturas entram pela página
// pública (login/home) e são tratadas pelo Admin do Sistema.
// ---------------------------------------------------------------------------

enum SupplierDevTrack {
  BUROCRACIA // credenciamento, licenças, certificações, conformidade
  PARCERIA // procura de parceiro internacional / transferência de tecnologia
  AMBOS
}

enum SupplierDevStatus {
  RECEBIDA
  EM_ANALISE
  EM_ACOMPANHAMENTO
  CONCLUIDA
  REJEITADA
}

model SupplierDevRequest {
  id        String @id @default(uuid())
  reference String @unique // ex: SD-2026-00001

  // A candidatura é PÚBLICA: pode vir de uma empresa ainda não registada.
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  companyName   String            @map("company_name")
  taxId         String?           @map("tax_id")
  contactName   String            @map("contact_name")
  contactEmail  String            @map("contact_email")
  contactPhone  String?           @map("contact_phone")
  province      String?
  sector        String? // área de atividade
  employees     Int?
  track         SupplierDevTrack  @default(AMBOS)
  needs         String? // o que precisa / objetivos
  // TAXA DE ACESSO ao programa (USD/mês) — igual à taxa de acesso das pequenas
  // empresas e COBRADA LOGO NA SUBMISSÃO DA INTENÇÃO. Fica emitida como
  // PENDENTE no momento da candidatura; o Admin do Sistema regista a receção.
  accessFeeUsd  Decimal?          @map("access_fee_usd") @db.Decimal(10, 2)
  feeStatus     PlatformFeeStatus @default(PENDENTE) @map("fee_status")
  feePaidAt     DateTime?         @map("fee_paid_at")
  // O RESTANTE do programa é orçamentado caso a caso após a triagem.
  // customPricing = true enquanto esse orçamento ainda não foi definido.
  programFeeUsd Decimal?          @map("program_fee_usd") @db.Decimal(12, 2)
  customPricing Boolean           @default(true) @map("custom_pricing")
  status        SupplierDevStatus @default(RECEBIDA)
  adminNotes    String?           @map("admin_notes")
  handledById   String?           @map("handled_by_id")
  handledAt     DateTime?         @map("handled_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@map("supplier_dev_requests")
}
